# ---- Pronto Reporting API credentials ----
# Base origin of the Pronto instance. Historic prod is https://havaspronto.com
PRONTO_BASE_URL=https://havaspronto.com

# MULTI-USER MODE (team sharing): leave ALL credentials below EMPTY. Users then
# sign in on the app's login screen with their own HavasPronto account (or a
# pasted API token). Each user's dashboards, widgets and cached report data are
# stored against THEIR Pronto user id (data/users/<id>/, cache partitioned).
#
# Optional: page on havaspronto.com where users can generate an API token.
# When set, the login screen shows a "Get a token" link to it.
TOKEN_GENERATOR_URL=

# "Sign in with HavasPronto" (PKCE broker, hosted by the Pronto site — the same
# flow the Pronto Time Tracker desktop app uses; SSO included). Enabled by
# default; endpoints derive from PRONTO_BASE_URL. Set PRONTO_BROKER=off to hide.
# PRONTO_PKCE_START_URL=      (default {base}/api/v2/app/pkce/start)
# PRONTO_PKCE_EXCHANGE_URL=   (default {base}/api/v2/app/pkce/exchange)
# PRONTO_BROKER_LOGIN_URL=    (default: login_url from start, else {base}/v2/?txn_id=...)
# PRONTO_BROKER=

# SINGLE-USER FALLBACK — if any of the credentials below are set, requests
# without a login session run as that one identity (handy for local dev).
#
# 1) Email + password (RECOMMENDED for standalone hosting). The server logs in via
#    POST /v2/api/auth/login, caches the returned token, sends it as
#    Authorization: Bearer, and re-logs-in automatically on a 401.
PRONTO_EMAIL=
PRONTO_PASSWORD=

# 2) Manual bearer token. If you already hold a token, paste it and it will be
#    used directly (no login performed). Overrides email/password.
PRONTO_BEARER_TOKEN=

# 3) Cookie session (legacy same-origin fallback). Raw "cookie:" header value from
#    an authenticated browser session (devtools -> Network -> a /v2/ajax/reports
#    request -> copy the whole "cookie:" value).
PRONTO_COOKIE=

# ---- Server ----
PORT=8787

# ---- Cache ----
# Historic data never changes, so cached report responses are kept permanently.
CACHE_DIR=.cache
CACHE_ENABLED=true

# ---- Persistent store (REQUIRED for serverless / Vercel) ----
# The dashboard keeps saved dashboards, user sessions, the PKCE pending-login
# state and the report cache in a store. On a single always-on box that store is
# the local filesystem (leave everything below empty). On a serverless host like
# Vercel the filesystem is read-only + ephemeral, so this state MUST live in
# Redis. Provision Upstash Redis from the Vercel Marketplace (Storage tab, or
# `vercel install upstash`) and it injects these two variables automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also accepted.)
#
# Alternatively, point at any Redis over a standard connection string (used via
# ioredis — good for a local redis or a long-lived VM host):
# REDIS_URL=redis://localhost:6379
#
# When none of the above are set, the app uses the local filesystem exactly as
# before — no behaviour change for local development.
